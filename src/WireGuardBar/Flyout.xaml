<Window x:Class="WireGuardBar.Flyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WireGuardBar"
        Title="WireGuard" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <!--
        WireGuard
        ─────────────
        Tunnel 1      Connect
        Tunnel 2   Disconnect

        Manage           Quit
    -->
    <Border Background="Black" CornerRadius="10" Padding="16" Width="264">
        <StackPanel>
            <TextBlock Text="WireGuard" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Rectangle Height="1" Fill="#26FFFFFF"/>

            <StackPanel Margin="0,12,0,8">
                <TextBlock Text="No tunnels" Style="{StaticResource Secondary}" FontSize="12"
                           Visibility="{Binding Tunnels.Count, Converter={StaticResource Is}, ConverterParameter=not}"/>
                <ItemsControl ItemsSource="{Binding Tunnels}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:TunnelItem">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- keeps its slot when off so names align -->
                                <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Left"
                                         Visibility="{Binding IsUp, Converter={StaticResource Is}, ConverterParameter=hidden}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Column="2">
                                    <Button Style="{StaticResource PillButton}" Content="{Binding ActionText}" Click="Toggle_Click"
                                            AutomationProperties.Name="{Binding ActionText}"
                                            Visibility="{Binding Busy, Converter={StaticResource Is}, ConverterParameter=not hidden}"/>
                                    <local:ConnectingOrb AutomationProperties.Name="Connecting"
                                                         Visibility="{Binding Busy, Converter={StaticResource Is}}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ConflictText}" Foreground="{StaticResource OrangeBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding ConflictText, Converter={StaticResource Is}}"/>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource RedBrush}" FontSize="12" TextWrapping="Wrap" Cursor="Hand"
                           MouseLeftButtonUp="Error_Click" ToolTip="Click to dismiss"
                           Visibility="{Binding Error, Converter={StaticResource Is}}"/>
            </StackPanel>

            <DockPanel LastChildFill="False">
                <Button Content="Manage" Style="{StaticResource PlainButton}" Click="Manage_Click"/>
                <Button Content="Quit" Style="{StaticResource PlainButton}" Click="Quit_Click" DockPanel.Dock="Right"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
