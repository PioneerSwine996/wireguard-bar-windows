<Window x:Class="WireGuardBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WireGuardBar"
        Title="WireGuard Tunnels" Width="780" Height="820" MinWidth="660" MinHeight="720"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- one row of the overview: label left, value right -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="14,9"/>
            <Setter Property="LastChildFill" Value="False"/>
        </Style>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="14,0,0,6"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: tunnel list, or (collapsed) a rail of numbered badges with status lights -->
        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top" Style="{StaticResource IconButton}" Content="&#xE90C;" Click="ToggleSidebar_Click"
                    HorizontalAlignment="Left" Margin="16,10,0,6" ToolTip="Collapse or expand the sidebar"
                    AutomationProperties.Name="Toggle sidebar"/>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Content="&#xE710;" Click="Import_Click"
                    HorizontalAlignment="Left" Margin="16,6,0,12" ToolTip="Import a tunnel from a .conf file"
                    AutomationProperties.Name="Import tunnel"/>
            <Grid>
                <ListBox Width="220" ItemsSource="{Binding Tunnels}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding Compact, Converter={StaticResource Is}, ConverterParameter=not}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="10,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:TunnelItem">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ItemsControl Width="60" ItemsSource="{Binding Tunnels}" Focusable="False" Margin="0,4,0,0"
                              Visibility="{Binding Compact, Converter={StaticResource Is}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:TunnelItem">
                            <Button Click="Rail_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,10"
                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="36" Height="36">
                                            <Border x:Name="Bg" CornerRadius="9" Background="#12FFFFFF">
                                                <TextBlock x:Name="Num" Text="{Binding Number}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource SecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- status light, ringed in the window colour so it reads against the badge -->
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource WindowBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                                <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Num" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>

        <Rectangle Grid.Column="1" Fill="#0FFFFFFF"/>

        <!-- Detail -->
        <Grid Grid.Column="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Selected, Converter={StaticResource Is}, ConverterParameter=not}">
                <TextBlock Text="No Tunnels" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Import a .conf file with +." Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer DataContext="{Binding Selected}" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Converter={StaticResource Is}}">
                <StackPanel Margin="24,0,24,24" MaxWidth="560">
                    <local:TunnelGlobe Height="300"/>

                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,10"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="Enabled"
                                          IsChecked="{Binding EnabledSwitch, Mode=TwoWay}"
                                          IsEnabled="{Binding Busy, Converter={StaticResource Is}, ConverterParameter=not}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Route all traffic" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="Route all traffic"
                                          IsChecked="{Binding RouteAll, Mode=TwoWay}"
                                          IsEnabled="{Binding Busy, Converter={StaticResource Is}, ConverterParameter=not}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Connected to server"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ConnectedText}" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Data sent"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SendBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SentText}" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Data received"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource ReceiveBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReceivedText}" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Latest handshake"/>
                                <TextBlock Text="{Binding HandshakeText}" Style="{StaticResource Value}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Endpoint"/>
                                <TextBlock Text="{Binding EndpointText}" Style="{StaticResource Value}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="On-Demand" Style="{StaticResource Header}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="On-Demand" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="On-Demand"
                                          IsChecked="{Binding OnDemandEnabled, Mode=TwoWay}"/>
                            </DockPanel>
                            <StackPanel Visibility="{Binding OnDemandEnabled, Converter={StaticResource Is}}">
                                <ItemsControl ItemsSource="{Binding Networks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Style="{StaticResource Row}" Margin="14,3">
                                                <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE738;" FontSize="11" DockPanel.Dock="Right"
                                                        Click="RemoveNetwork_Click" ToolTip="Remove" AutomationProperties.Name="Remove network"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="14,6" LastChildFill="True">
                                    <Button Content="Add" Style="{StaticResource FilledButton}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="AddNetwork_Click"/>
                                    <Grid>
                                        <TextBox x:Name="NewNetwork" KeyDown="NewNetwork_KeyDown" AutomationProperties.Name="Wi-Fi name"/>
                                        <TextBlock Text="Wi-Fi name" Style="{StaticResource Secondary}" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=NewNetwork, Converter={StaticResource Is}, ConverterParameter=not}"/>
                                    </Grid>
                                </DockPanel>
                                <Button Content="{Binding AddCurrentText}" Style="{StaticResource PlainButton}" Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" Margin="14,6,14,9" Click="AddCurrent_Click"
                                        IsEnabled="{Binding CanAddCurrent}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Group}">
                        <Button Style="{StaticResource PlainButton}" Foreground="{StaticResource TextBrush}" Padding="14,9"
                                HorizontalContentAlignment="Left" Click="EditConfig_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                <TextBlock Text="Edit Configuration…" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Error banner: click to dismiss -->
        <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Background="#D9FF3B30" Padding="12,10" Cursor="Hand"
                MouseLeftButtonUp="Error_Click" Visibility="{Binding Error, Converter={StaticResource Is}}">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="White" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Config editor, shown inside the window after Windows Hello -->
        <Grid x:Name="Editor" Grid.ColumnSpan="3" Background="#B3000000" Visibility="Collapsed">
            <Border Background="#FF161616" CornerRadius="12" Padding="20" Margin="40" MaxWidth="760" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock x:Name="EditorTitle" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
                        <TextBlock x:Name="EditorError" Foreground="{StaticResource RedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}" DockPanel.Dock="Right" Click="Save_Click"/>
                        <Button Content="Cancel" Style="{StaticResource FilledButton}" DockPanel.Dock="Right" Margin="0,0,8,0" Click="Cancel_Click"/>
                    </DockPanel>
                    <TextBox x:Name="EditorText" FontFamily="{StaticResource MonoFont}" Height="380" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             SpellCheck.IsEnabled="False" AutomationProperties.Name="Configuration"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
